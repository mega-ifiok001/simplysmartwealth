# Copy to .env and enter credentials locally. Never commit .env.
# DIRECT_URL: same Neon database, without connection pooling.
DATABASE_URL=""
DIRECT_URL=""
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Public site URL used in account-verification and newsletter emails.
APP_URL="http://localhost:3000"

# Email delivery: EMAIL_MODE=console logs messages in development; set to
# resend in production with a Resend API key.
EMAIL_MODE="console"
RESEND_API_KEY=""
# EMAIL_FROM must use a domain verified in Resend, otherwise Resend
# rejects sends with a 403.
EMAIL_FROM="Simply Smart Wealth <noreply@example.com>"

# Where contact-form notifications are sent (optional).
CONTACT_NOTIFY_EMAIL=""

# Set to true ONLY when a trusted proxy (e.g. your host's load balancer)
# overwrites x-forwarded-for; enables per-IP rate limiting behind a proxy.
TRUST_PROXY="false"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
ADMIN_EMAIL=""
ADMIN_NAME=""
ADMIN_PASSWORD=""
