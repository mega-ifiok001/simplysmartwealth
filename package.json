{
  "name": "simplysmartwealth",
  "version": "1.0.0",
  "private": true,
  "description": "Simply Smart Wealth - Personal blog built with Next.js (migrated from the Stories HTML template)",
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "prisma generate && next build",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke-fullstack.mjs",
    "test:live": "node --env-file=.env scripts/test-live-integration.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:backup": "node --env-file=.env scripts/backup-db.mjs backup",
    "db:restore": "node --env-file=.env scripts/backup-db.mjs restore",
    "admin:create": "node --env-file=.env scripts/create-admin.mjs",
    "admin:password": "node --env-file=.env scripts/set-admin-password.mjs",
    "start": "next start",
    "verify": "node scripts/verify-production.mjs",
    "convert": "node scripts/convert-html.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "next": "^15.5.25",
    "next-auth": "^4.24.15",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "resend": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "cheerio": "^1.1.2",
    "prisma": "^6.19.3",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "deepmerge-ts": "^8.0.2"
  }
}
