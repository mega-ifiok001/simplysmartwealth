generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model Admin {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role String @default("ADMIN")
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts Post[]
  revisions PostRevision[]
  auditLogs AuditLog[]
  campaigns NewsletterCampaign[]
}

model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  description String @default("")
  icon String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts PostCategory[]
}

model Post {
  id String @id @default(cuid())
  title String
  slug String @unique
  excerpt String
  content String @db.Text
  status PostStatus @default(DRAFT)
  coverUrl String?
  coverPublicId String?
  coverAlt String @default("")
  featured Boolean @default(false)
  views Int @default(0)
  authorId String
  author Admin @relation(fields: [authorId], references: [id], onDelete: Restrict)
  categories PostCategory[]
  tags PostTag[]
  comments Comment[]
  revisions PostRevision[]
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
}

model PostCategory {
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

model Comment {
  id String @id @default(cuid())
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  readerId String?
  reader Reader? @relation(fields: [readerId], references: [id], onDelete: SetNull)
  authorName String
  content String @db.Text
  approved Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([postId, approved, createdAt])
}

model ContactMessage {
  id String @id @default(cuid())
  name String
  email String
  phone String @default("")
  subject String @default("")
  message String @db.Text
  read Boolean @default(false)
  resolved Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([resolved, createdAt])
}

model SubmissionAttempt {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}

model SiteSetting {
  id String @id @default(cuid())
  key String @unique
  value String @db.Text
  updatedAt DateTime @updatedAt
}

model Subscriber {
  id String @id @default(cuid())
  email String @unique
  name String?
  confirmed Boolean @default(false)
  unsubscribedAt DateTime?
  createdAt DateTime @default(now())

  @@index([confirmed])
}

model Reader {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  name String?
  emailVerified DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comments Comment[]
}

model Tag {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  posts PostTag[]
}

model PostTag {
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId String
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model PostRevision {
  id String @id @default(cuid())
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author Admin @relation(fields: [authorId], references: [id], onDelete: Restrict)
  title String
  excerpt String
  content String @db.Text
  coverUrl String?
  coverAlt String @default("")
  createdAt DateTime @default(now())

  @@index([postId, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  adminId String?
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action String
  entity String
  entityId String
  detail Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum AuthPurpose {
  VERIFY_EMAIL
  PASSWORD_RESET
  NEWSLETTER_CONFIRM
  NEWSLETTER_UNSUB
}

model AuthToken {
  id String @id @default(cuid())
  email String
  tokenHash String @unique
  purpose AuthPurpose
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

model NewsletterCampaign {
  id String @id @default(cuid())
  subject String
  body String @db.Text
  status String @default("DRAFT")
  sentAt DateTime?
  recipientCount Int @default(0)
  authorId String?
  author Admin? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
